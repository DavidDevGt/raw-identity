# Copy to .env for local use. Set the same values in your hosting provider or CI.
# Values are read at build time (static output), so changing one needs a rebuild.

# Canonical origin used for canonical links, hreflang, the sitemap and robots.txt.
SITE_URL=https://davidwebgt.com

# Optional. Endpoint that receives Core Web Vitals beacons (LCP, INP, CLS) from real users.
# Leave empty to disable field-metric reporting.
PUBLIC_VITALS_ENDPOINT=
