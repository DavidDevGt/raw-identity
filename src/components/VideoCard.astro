---
import { getRelativeLocaleUrl } from 'astro:i18n';
import type { Video } from '../data/videos';
import type { Lang } from '../i18n/paths';
import { t } from '../i18n/ui';
import { formatTime } from '../scripts/player-state';
import Arrow from './Arrow.astro';
import ProjectShot from './ProjectShot.astro';

interface Props {
	video: Video;
	lang: Lang;
}

const { video, lang } = Astro.props;
const { slug, width, height, duration, av1, layout, project, copy } = video;
const { title, description } = copy[lang];
const base = `/videos/${slug}`;

const [minutes = 0, seconds = 0] = duration.split(':').map(Number);
const totalSeconds = minutes * 60 + seconds;
---

<article class:list={['video', `video--${layout}`]}>
	<div class="on-color inner">
		<div class="frame">
			<ProjectShot host={`${slug}.mp4`}>
				<div
					class="vplayer"
					data-state="idle"
					data-wants="false"
					data-video={base}
					data-av1={av1 ? '' : undefined}
					data-duration={totalSeconds}
					data-label-play={`${t(lang, 'videos.play')}: ${title}`}
					data-label-pause={`${t(lang, 'videos.pause')}: ${title}`}
				>
					<div class="stage">
						<!--
							A poster that links to the file, so a page with six clips downloads no video until one is played.
							data-astro-reload keeps the client router from treating the file as a page to navigate to.
						-->
						<a class="start" data-astro-reload href={`${base}.mp4`} aria-label={`${t(lang, 'videos.play')}: ${title} (${duration})`}>
							<img src={`${base}.webp`} width={width} height={height} alt="" loading="lazy" decoding="async" />
							<span class="big-play" aria-hidden="true"></span>
						</a>
						<span class="buffering" aria-hidden="true">_BUFFERING...</span>
					</div>

					<!-- Not laid over the picture: a hardware module bolted to the bottom of the window. -->
					<div class="deck">
						<input
							class="scrub"
							type="range"
							min="0"
							max="100"
							step="1"
							value="0"
							disabled
							aria-label={`${t(lang, 'videos.seek')}: ${title}`}
						/>
						<div class="row">
							<div class="transport">
								<button class="key toggle" type="button" aria-label={`${t(lang, 'videos.play')}: ${title}`}>
									<span class="icon" aria-hidden="true"></span>
								</button>
								<p class="readout">
									<span class="clock">{formatTime(0)} / {formatTime(totalSeconds)}</span>
									<span class="status" aria-hidden="true">_IDLE</span>
								</p>
							</div>
							<div class="volume" role="group" aria-label={t(lang, 'videos.volume')}>
								<button class="key small volume-down" type="button" aria-label={t(lang, 'videos.volumeDown')}>-</button>
								<span class="bars" aria-hidden="true"><i class="on"></i><i class="on"></i><i class="on"></i><i class="on"></i></span>
								<span class="level">100</span>
								<button class="key small volume-up" type="button" aria-label={t(lang, 'videos.volumeUp')} disabled>+</button>
							</div>
							<button class="key small fullscreen" type="button" aria-label={`${t(lang, 'videos.fullscreen')}: ${title}`} disabled>
								<span class="corners" aria-hidden="true"></span>
							</button>
						</div>
					</div>
				</div>
			</ProjectShot>
		</div>
		<div class="copy">
			<h3>{title}</h3>
			<p>{description}</p>
			{
				project && (
					<a class="project" href={getRelativeLocaleUrl(lang, `work/${project}`)}>
						{t(lang, 'videos.project')}
						<Arrow />
					</a>
				)
			}
		</div>
	</div>
</article>

<script>
	import '../scripts/video-player';
</script>

<style>
	.video {
		height: 100%;
		background: var(--video-bg);
		color: var(--on-color);
		border: var(--border-width) solid var(--ink);
		box-shadow: 8px 8px 0 var(--video-cast);
	}

	.inner {
		display: flex;
		flex-direction: column;
		gap: var(--space-4);
		height: 100%;
		padding: clamp(0.875rem, 2vw, 1.5rem);
	}

	.frame {
		/* Room for the player's hard shadow inside the card. */
		padding: 0 8px 8px 0;
	}

	/* The controls measure the player and not the card, so fullscreen gets the wide deck on any clip. */
	.vplayer {
		container-type: inline-size;
	}

	.frame :global(.shot) {
		border-width: 4px;
		border-radius: 0;
		box-shadow: 8px 8px 0 var(--line);
	}

	/* Picture */
	.stage {
		position: relative;
		background: var(--line);
	}

	.start {
		position: relative;
		display: block;
	}

	.start img,
	.stage :global(video) {
		display: block;
		width: 100%;
		height: auto;
	}

	.stage :global(video) {
		cursor: pointer;
	}

	/* Vertical clips come in 2:3 and 9:16. One shape for all keeps their decks level across the row. */
	.video--tall .stage {
		aspect-ratio: 2 / 3;
		overflow: hidden;
	}

	.video--tall .start,
	.video--tall .start img,
	.video--tall .stage :global(video) {
		height: 100%;
	}

	.video--tall .start img,
	.video--tall .stage :global(video) {
		object-fit: cover;
	}

	.start:focus-visible {
		outline: 4px solid var(--color-lemon);
		outline-offset: -8px;
	}

	.big-play {
		position: absolute;
		top: 50%;
		left: 50%;
		width: clamp(3.5rem, 18cqi, 5.5rem);
		aspect-ratio: 1;
		background: var(--color-lemon);
		border: var(--border-width) solid var(--line);
		box-shadow: 6px 6px 0 var(--line);
		translate: -50% -50%;
		rotate: -4deg;
	}

	.big-play::after {
		content: '';
		position: absolute;
		inset: 26% 22% 26% 32%;
		background: var(--line);
		clip-path: polygon(0 0, 100% 50%, 0 100%);
	}

	.start:hover .big-play {
		background: var(--color-aqua);
	}

	.start:active .big-play {
		box-shadow: none;
		transform: translate(6px, 6px);
	}

	.buffering {
		display: none;
		position: absolute;
		top: 0.5rem;
		left: 0.5rem;
		padding: 0.15rem 0.45rem;
		background: var(--line);
		color: var(--color-lemon);
		font-family: var(--font-label);
		font-size: 0.8125rem;
		font-weight: 700;
		pointer-events: none;
	}

	[data-state='buffering'] .buffering {
		display: block;
	}

	@media (prefers-reduced-motion: no-preference) {
		[data-state='buffering'] .buffering {
			animation: blink 0.8s steps(1) infinite;
		}
	}

	@keyframes blink {
		50% {
			opacity: 0;
		}
	}

	/* Deck */
	.deck {
		display: grid;
		gap: 0.5rem;
		padding: 0.5rem 0.625rem 0.75rem;
		background: var(--paper);
		color: var(--line);
		border-top: 4px solid var(--line);
	}

	.row {
		display: flex;
		align-items: center;
		gap: 0.5rem 0.75rem;
	}

	.transport {
		display: flex;
		flex: 1;
		gap: 0.5rem;
		min-width: 0;
	}

	/* Scrubber: hazard stripes on the rail, acid fill, and a notched block that sticks out of it. */
	.scrub {
		--progress: 0%;
		appearance: none;
		display: block;
		width: 100%;
		height: 2rem;
		margin: 0;
		background: transparent;
		cursor: pointer;
	}

	.scrub:disabled {
		cursor: not-allowed;
	}

	.scrub:focus-visible {
		outline: 3px solid var(--line);
		outline-offset: 2px;
	}

	.scrub::-webkit-slider-runnable-track {
		height: 14px;
		background:
			linear-gradient(to right, var(--color-pink) var(--progress), transparent 0),
			repeating-linear-gradient(-45deg, var(--line) 0 3px, var(--paper) 0 9px);
		border: 3px solid var(--line);
	}

	.scrub::-moz-range-track {
		height: 8px;
		background:
			linear-gradient(to right, var(--color-pink) var(--progress), transparent 0),
			repeating-linear-gradient(-45deg, var(--line) 0 3px, var(--paper) 0 9px);
		border: 3px solid var(--line);
	}

	.scrub::-webkit-slider-thumb {
		appearance: none;
		width: 18px;
		height: 30px;
		margin-top: -11px;
		background: var(--color-lemon);
		border: 3px solid var(--line);
		border-radius: 0;
		clip-path: polygon(0 0, 100% 0, 100% 100%, 40% 100%, 0 70%);
	}

	.scrub::-moz-range-thumb {
		width: 12px;
		height: 24px;
		background: var(--color-lemon);
		border: 3px solid var(--line);
		border-radius: 0;
		clip-path: polygon(0 0, 100% 0, 100% 100%, 40% 100%, 0 70%);
	}

	.scrub:hover:not(:disabled)::-webkit-slider-thumb {
		background: var(--color-aqua);
	}

	.scrub:hover:not(:disabled)::-moz-range-thumb {
		background: var(--color-aqua);
	}

	.scrub:disabled::-webkit-slider-thumb {
		background: var(--paper);
	}

	.scrub:disabled::-moz-range-thumb {
		background: var(--paper);
	}

	/*
	 * Keys are mechanical: no transitions, and a press travels exactly the length of the shadow,
	 * so the key lands on it.
	 */
	.key {
		--travel: 5px;
		display: grid;
		flex: none;
		place-items: center;
		width: 3.25rem;
		height: 2.75rem;
		margin: 0 var(--travel) var(--travel) 0;
		padding: 0;
		background: var(--color-lemon);
		color: var(--line);
		border: 3px solid var(--line);
		border-radius: 0;
		box-shadow: var(--travel) var(--travel) 0 var(--line);
		font-family: var(--font-label);
		font-size: 1.25rem;
		font-weight: 700;
		line-height: 1;
		cursor: pointer;
	}

	.key:hover:not(:disabled) {
		background: var(--line);
		color: var(--color-lemon);
	}

	.key:active:not(:disabled) {
		box-shadow: none;
		transform: translate(var(--travel), var(--travel));
	}

	.key:focus-visible {
		outline: 3px solid var(--line);
		outline-offset: 3px;
	}

	.key:disabled {
		background: var(--paper);
		color: color-mix(in srgb, var(--line) 45%, var(--paper));
		cursor: not-allowed;
	}

	.key.small {
		--travel: 3px;
		width: 2.75rem;
		background: var(--paper);
	}

	.key.small:hover:not(:disabled) {
		background: var(--line);
		color: var(--paper);
	}

	/* The icon is drawn from the same state as everything else. */
	.icon {
		width: 1.125rem;
		height: 1.125rem;
		background: currentColor;
		clip-path: polygon(10% 0, 100% 50%, 10% 100%);
	}

	[data-wants='true'] .icon {
		clip-path: polygon(0 0, 36% 0, 36% 100%, 0 100%, 0 0, 64% 0, 100% 0, 100% 100%, 64% 100%, 64% 0);
	}

	.corners {
		width: 1.125rem;
		height: 1.125rem;
		background:
			linear-gradient(currentColor, currentColor) 0 0 / 7px 3px,
			linear-gradient(currentColor, currentColor) 0 0 / 3px 7px,
			linear-gradient(currentColor, currentColor) 100% 0 / 7px 3px,
			linear-gradient(currentColor, currentColor) 100% 0 / 3px 7px,
			linear-gradient(currentColor, currentColor) 0 100% / 7px 3px,
			linear-gradient(currentColor, currentColor) 0 100% / 3px 7px,
			linear-gradient(currentColor, currentColor) 100% 100% / 7px 3px,
			linear-gradient(currentColor, currentColor) 100% 100% / 3px 7px;
		background-repeat: no-repeat;
	}

	/* The display: a dark panel set into the deck, lined up with the faces of the keys beside it. */
	.readout {
		display: flex;
		flex: 1 1 9rem;
		flex-wrap: wrap;
		max-width: 22rem;
		align-items: center;
		align-self: stretch;
		align-content: center;
		justify-content: space-between;
		gap: 0 0.75rem;
		min-width: 0;
		margin: 0 0 5px;
		padding: 0.25rem 0.5rem;
		background: var(--line);
		color: var(--color-lemon);
		font-family: var(--font-label);
		font-weight: 700;
		line-height: 1.3;
		white-space: nowrap;
	}

	.clock {
		font-size: 0.875rem;
	}

	.status {
		color: var(--color-aqua);
		font-size: 0.6875rem;
	}

	[data-state='error'] .status {
		color: var(--color-pink);
	}

	/* Volume: five fixed levels, shown as retro equalizer bars. */
	.volume {
		display: flex;
		flex: none;
		align-items: center;
		gap: 0.375rem;
		font-family: var(--font-label);
		font-size: 0.75rem;
		font-weight: 700;
	}

	.bars {
		display: flex;
		align-items: flex-end;
		gap: 2px;
		height: 1.5rem;
		margin-bottom: 3px;
	}

	.bars i {
		display: block;
		width: 6px;
		background: var(--paper);
		border: 2px solid var(--line);
	}

	.level {
		margin-bottom: 3px;
	}

	/*
	 * A narrow deck, like the vertical clips and phones: two rows that both reach the edges.
	 * Transport and display on top, then volume with the bars taking the slack, and fullscreen.
	 */
	@container (max-width: 28rem) {
		.row {
			display: grid;
			grid-template-columns: minmax(0, 1fr) auto;
			gap: 0.5rem;
		}

		.transport {
			grid-column: 1 / -1;
			display: flex;
			gap: 0.5rem;
		}

		.readout {
			max-width: none;
		}

		.volume {
			min-width: 0;
		}

		.bars {
			flex: 1;
			min-width: 2.5rem;
		}

		.bars i {
			flex: 1;
			width: auto;
		}
	}

	/* Too tight for the number: the bars already say it. */
	@container (max-width: 16rem) {
		.level {
			display: none;
		}
	}

	.bars i:nth-child(1) {
		height: 35%;
	}

	.bars i:nth-child(2) {
		height: 55%;
	}

	.bars i:nth-child(3) {
		height: 78%;
	}

	.bars i:nth-child(4) {
		height: 100%;
	}

	.bars i.on {
		background: var(--color-pink);
	}

	.level {
		min-width: 3ch;
		text-align: right;
	}

	/* Fullscreen: the deck stays attached and the picture takes the rest. */
	.vplayer:fullscreen {
		display: flex;
		flex-direction: column;
		background: var(--line);
	}

	.video .vplayer:fullscreen .stage {
		flex: 1;
		min-height: 0;
		aspect-ratio: auto;
	}

	.video .vplayer:fullscreen .stage :global(video) {
		width: 100%;
		height: 100%;
		object-fit: contain;
	}

	/* Copy */
	.copy h3 {
		margin: 0;
		font-size: clamp(1.75rem, 1.4rem + 1.2vw, 2.5rem);
		font-weight: 400;
	}

	.copy p {
		margin: var(--space-2) 0 0;
		font-size: 1.0625rem;
		font-weight: 500;
	}

	.project {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		margin-top: var(--space-3);
		padding: 0.45rem 0.6rem;
		background: var(--line);
		color: var(--paper);
		font-size: 0.875rem;
		font-weight: 800;
		text-decoration: none;
		text-transform: uppercase;
	}

	.project:hover {
		background: var(--paper);
		color: var(--line);
	}

	.project:focus-visible {
		outline: 4px solid var(--line);
		outline-offset: 3px;
	}

	/* The short film gets the room: the player takes most of the card and the title sits beside it. */
	@media (min-width: 60rem) {
		.video--feature .inner {
			flex-direction: row;
			align-items: center;
			gap: var(--space-5);
		}

		.video--feature .frame {
			flex: 0 0 72%;
			min-width: 0;
		}

		.video--feature .copy h3 {
			font-size: clamp(2.5rem, 1.5rem + 2vw, 4rem);
		}
	}
</style>
