---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { creatorVideos } from '../data/videos';
import type { Lang } from '../i18n/paths';
import { t } from '../i18n/ui';
import Arrow from './Arrow.astro';
import Mascot from './Mascot.astro';
import StarBurst from './StarBurst.astro';
import VideoCard from './VideoCard.astro';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;

// The photo is src/assets/david.(jpg|jpeg|png|webp). Until that file exists, the terminal mascot stands in for it.
const photos = import.meta.glob<{ default: ImageMetadata }>('../assets/david.{jpg,jpeg,png,webp}', { eager: true });
const photo = Object.values(photos)[0]?.default;

const handle = '@daviddevgt';
const socials = [
	{ name: 'YouTube', href: 'https://www.youtube.com/@daviddevgt', tone: 'pink' },
	{ name: 'TikTok', href: 'https://www.tiktok.com/@daviddevgt', tone: 'aqua' },
	{ name: 'Instagram', href: 'https://www.instagram.com/daviddevgt/', tone: 'violet' },
];
---

<div class="creator">
	<article class="profile on-color slap">
		<div class="photo-wrap">
			{
				photo ? (
					<Image class="photo" src={photo} alt={t(lang, 'creator.photoAlt')} widths={[320, 400]} sizes="(min-width: 40rem) 22rem, 80vw" />
				) : (
					<div class="photo photo--empty">
						<Mascot />
					</div>
				)
			}
			<div class="photo-star"><StarBurst label={t(lang, 'hero.sticker')} /></div>
		</div>
		<p class="handle">{handle}</p>
		<p class="bio">{t(lang, 'creator.bio')}</p>
		<ul class="socials">
			{
				socials.map(({ name, href, tone }) => (
					<li>
						<a class:list={['social', `social--${tone}`]} href={href} target="_blank" rel="me noopener">
							{name}
							<Arrow />
						</a>
					</li>
				))
			}
		</ul>
	</article>

	<ul class="voice">
		{
			creatorVideos.map((video) => (
				<li class="slap">
					<VideoCard video={video} lang={lang} />
				</li>
			))
		}
	</ul>

	<a class="gen on-color slap" href={`${getRelativeLocaleUrl(lang, 'work/genruntime')}#clips`}>
		<span class="gen-text">
			<strong>{t(lang, 'creator.genTitle')}</strong>
			<span>{t(lang, 'creator.genText')}</span>
		</span>
		<span class="gen-cta">
			{t(lang, 'creator.genCta')}
			<Arrow />
		</span>
	</a>
</div>

<style>
	.creator {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: var(--space-5);
		margin-top: var(--space-5);
	}

	.profile {
		--slap-x: -5vw;
		--slap-r: -2deg;
		display: grid;
		align-content: start;
		gap: var(--space-4);
		padding: clamp(1.25rem, 3vw, 2rem);
		background: var(--color-lemon);
		color: var(--on-color);
		border: var(--border-width) solid var(--ink);
		box-shadow: 8px 8px 0 var(--color-pink);
	}

	.photo-wrap {
		position: relative;
		width: min(100%, 22rem);
		margin-inline: auto;
		transform: rotate(-2deg);
	}

	.photo {
		display: block;
		width: 100%;
		height: auto;
		border: var(--border-width) solid var(--ink);
		box-shadow: 8px 8px 0 var(--ink);
	}

	.photo--empty {
		display: grid;
		place-items: center;
		aspect-ratio: 4 / 5;
		padding: 1.25rem;
		background: var(--color-purple);
	}

	.photo-star {
		position: absolute;
		top: -1.25rem;
		right: -1.25rem;
		width: clamp(4.5rem, 22%, 6rem);
		transform: rotate(10deg);
		--star-fill: var(--color-pink);
	}

	.handle {
		justify-self: start;
		max-width: 100%;
		margin: 0;
		padding: 0.1em 0.35em 0.15em;
		background: var(--ink);
		color: var(--color-lemon);
		font-family: var(--font-head);
		font-size: clamp(2.25rem, 1.75rem + 2vw, 3.25rem);
		line-height: 1.15;
		transform: rotate(-1.5deg);
	}

	.bio {
		margin: 0;
		font-size: 1.0625rem;
		font-weight: 500;
	}

	.socials {
		display: grid;
		gap: var(--space-3);
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.social {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-3);
		padding: 0.7rem 1rem;
		background: var(--social-bg);
		color: var(--on-color);
		border: var(--border-width) solid var(--ink);
		box-shadow: 4px 4px 0 var(--ink);
		font-family: var(--font-head);
		font-size: 1.5rem;
		line-height: 1.2;
		text-decoration: none;
		text-transform: uppercase;
		transition:
			translate 120ms ease,
			box-shadow 120ms ease;
	}

	.social:hover,
	.social:active {
		translate: 4px 4px;
		box-shadow: none;
	}

	.social--pink {
		--social-bg: var(--color-pink);
	}

	.social--aqua {
		--social-bg: var(--color-aqua);
	}

	.social--violet {
		--social-bg: var(--color-violet);
	}

	.voice {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: var(--space-5);
		align-items: start;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.voice > li:nth-child(1) {
		--video-bg: var(--color-aqua);
		--video-cast: var(--color-violet);
		--slap-y: 4rem;
	}

	.voice > li:nth-child(2) {
		--video-bg: var(--color-pink);
		--video-cast: var(--color-aqua);
		--slap-y: 7rem;
	}

	/* Secondary on purpose: paper, not an acid color, and it spans the row under the main content. */
	.gen {
		--slap-y: 3rem;
		display: grid;
		gap: var(--space-3);
		padding: var(--space-4);
		background: var(--paper);
		color: var(--on-color);
		border: var(--border-width) solid var(--ink);
		box-shadow: 8px 8px 0 var(--color-lemon);
		text-decoration: none;
	}

	.gen-text {
		display: grid;
		gap: 0.25rem;
	}

	.gen-text strong {
		font-family: var(--font-head);
		font-size: 1.5rem;
		font-weight: 400;
		line-height: 1.2;
		text-transform: uppercase;
	}

	.gen-cta {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-family: var(--font-label);
		font-size: 0.875rem;
		font-weight: 700;
		text-transform: uppercase;
	}

	.gen:hover .gen-cta,
	.gen:focus-visible .gen-cta {
		text-decoration: underline;
		text-decoration-thickness: 3px;
	}

	@media (min-width: 40rem) {
		.voice {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.gen {
			grid-template-columns: minmax(0, 1fr) auto;
			align-items: center;
		}
	}

	/* From here the profile fits beside the videos. Any earlier, the players get too narrow for their controls. */
	@media (min-width: 72rem) {
		.creator {
			grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
		}

		.gen {
			grid-column: 1 / -1;
		}
	}
</style>
