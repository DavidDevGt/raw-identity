---
// Drawn instead of typed: the arrow glyph is not in the latin font subsets.
interface Props {
	direction?: 'right' | 'left';
}

const { direction = 'right' } = Astro.props;
---

<svg class:list={['arrow', direction]} viewBox="0 0 24 24" width="1em" aria-hidden="true" focusable="false">
	<path d="M2 12h19M13 4l8 8-8 8" fill="none" stroke="currentColor" stroke-width="4"></path>
</svg>

<style>
	.arrow {
		flex: none;
		width: 1em;
	}

	.left {
		transform: scaleX(-1);
	}
</style>
