---
// The cast: original characters built from tech objects, each with limbs made of its own material and its own
// attitude. Decorative only. Thin limbs and the hard body shadow have their own tokens (--limb, --drop), so they
// read on dark bands. A .sticker switches them to dark lines.
interface Props {
	name?: 'window' | 'server' | 'magnifier' | 'handheld' | 'cloud';
}

const { name = 'window' } = Astro.props;

// Unique per instance: a reference to an id inside a hidden copy of the same mascot would draw nothing.
const uid = `${name}-${crypto.randomUUID().slice(0, 8)}`;
const halftone = `url(#${uid}-dots)`;
const rough = `url(#${uid}-ink)`;

const viewBoxes = {
	window: '-10 46 340 274',
	server: '0 0 340 400',
	magnifier: '0 0 330 400',
	handheld: '-36 6 480 324',
	cloud: '-10 -50 400 400',
};

// What triggers a character's hover: its body, not the empty corners of its box.
const hitAreas = {
	window: { x: 40, y: 56, width: 240, height: 180 },
	server: { x: 46, y: 24, width: 248, height: 300 },
	magnifier: { x: 38, y: 8, width: 224, height: 224 },
	handheld: { x: 8, y: 36, width: 384, height: 284 },
	cloud: { x: 30, y: 50, width: 300, height: 170 },
};

// A coiled console cable between two points. The coil tapers at both ends so it lands exactly on them.
function coil(x1: number, y1: number, x2: number, y2: number, loops = 4, radius = 10) {
	const length = Math.hypot(x2 - x1, y2 - y1);
	const [ux, uy] = [(x2 - x1) / length, (y2 - y1) / length];
	const samples = loops * 12;
	const points = Array.from({ length: samples + 1 }, (_, i) => {
		const t = i / samples;
		const angle = t * loops * 2 * Math.PI;
		const reach = Math.min(1, 6 * t, 6 * (1 - t)) * radius;
		const along = t * length + reach * Math.sin(angle);
		const across = reach * Math.cos(angle);
		return `${(x1 + ux * along - uy * across).toFixed(1)} ${(y1 + uy * along + ux * across).toFixed(1)}`;
	});
	return `M${points.join('L')}`;
}

// The terminal's mismatched high-tops: the right one is the left one mirrored around the body's center line.
const shoes = [
	{ transform: undefined, upper: 'fill-aqua' },
	{ transform: 'translate(320 0) scale(-1 1)', upper: 'fill-lemon' },
];

// The gaming PC's fans: three on the radiator, two on the graphics card.
const fans = [
	{ x: 104, y: 77, scale: 0.62 },
	{ x: 170, y: 77, scale: 0.62 },
	{ x: 236, y: 77, scale: 0.62 },
];
const fanBlades = [0, 72, 144, 216, 288];

// The digits in the terminal's visor. Each column repeats every four rows (48 units), which is how far the animation
// moves it, so the loop has no visible seam. Each column falls at its own speed on hover, and every third one is
// brighter, like a leading stream.
const visor = 'M78 108H222L228 118V144L214 162H172L162 148H138L128 162H86L72 144V118Z';
const rainGlyphs = ['0', '1', '1', '0'];
const rainColumns = [68, 84, 100, 116, 132, 148, 164, 180, 196, 212, 228].map((x, column) => {
	const rows = Array.from({ length: 15 }, (_, row) => row);
	return {
		xs: rows.map(() => x).join(' '),
		ys: rows.map((row) => 86 + ((column * 5) % 12) + row * 12).join(' '),
		glyphs: rows.map((row) => rainGlyphs[(row + column * 3) % rainGlyphs.length]).join(''),
		bright: column % 3 === 0,
		speed: column % 4,
	};
});
---

<svg class:list={['mascot', `mascot--${name}`]} viewBox={viewBoxes[name]} aria-hidden="true" focusable="false">
