				</g>
				<text class="mono-led" x="58" y="84" font-size="15" textLength="122" lengthAdjust="spacingAndGlyphs">david@kurai:~$</text>
				<rect class="fill-led-flat cursor" x="184" y="71" width="11" height="15" />

				<!-- Confident: a cyberpunk visor with digits on its lenses, and a pixel smirk. -->
				<g transform="translate(10 0)">
					<clipPath id={`${uid}-visor`}>
						<path d={visor} />
					</clipPath>
					<path class="ink" d={visor} />
