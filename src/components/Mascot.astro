		<!-- Comic-print dots for the hard shadows. -->
		<pattern id={`${uid}-dots`} patternUnits="userSpaceOnUse" width="8" height="8" patternTransform="rotate(45)">
			<circle class="ink" cx="4" cy="4" r="2.1"></circle>
		</pattern>
		<!-- Nudges the outlines a little, so they read as ink and not as vectors. Text stays outside it. -->
		<filter id={`${uid}-ink`} x="-5%" y="-5%" width="110%" height="110%">
