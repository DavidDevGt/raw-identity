---
import { getRelativeLocaleUrl } from 'astro:i18n';
import type { Lang } from '../i18n/paths';
import { t } from '../i18n/ui';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;

// Home sections are anchors on the home page; the work list is its own route.
const workHref = getRelativeLocaleUrl(lang, 'work');
const links = [
	{ label: t(lang, 'nav.work'), href: workHref },
	{ label: t(lang, 'nav.videos'), href: `${getRelativeLocaleUrl(lang)}#videos` },
	{ label: t(lang, 'nav.how'), href: `${getRelativeLocaleUrl(lang)}#how` },
	{ label: t(lang, 'nav.experience'), href: `${getRelativeLocaleUrl(lang)}#experience` },
	{ label: t(lang, 'nav.contact'), href: `${getRelativeLocaleUrl(lang)}#contact` },
];
const onWork = Astro.url.pathname.startsWith(workHref.replace(/\/$/, ''));
---

<header class="site-header">
	<div class="container bar">
		<a class="brand" href={getRelativeLocaleUrl(lang)}>{t(lang, 'site.name')}</a>
		<button type="button" class="menu-toggle" aria-expanded="false" aria-controls="site-menu">
			<svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="20" height="20">
				<path class="icon-open" d="M3 6h18M3 12h18M3 18h18" />
				<path class="icon-close" d="M5 5l14 14M19 5L5 19" />
			</svg>
			{t(lang, 'nav.menu')}
		</button>
		<!-- On a phone the links and the language switcher live in a collapsible panel. From 60rem up the
		     panel disappears (display: contents) and its children sit in the bar. -->
		<div class="panel" id="site-menu">
			<nav aria-label={t(lang, 'nav.main')} class="main-nav">
				<ul>
					{
						links.map((link) => (
							<li>
								<a href={link.href} aria-current={link.href === workHref && onWork ? 'page' : undefined}>
									{link.label}
								</a>
							</li>
						))
					}
				</ul>
			</nav>
			<LanguageSwitcher lang={lang} />
		</div>
	</div>
</header>

<script>
	// Progressive enhancement: without JavaScript (see @media (scripting: none) below) the panel stays open.
	const OPEN = 'is-open';

	function setOpen(open: boolean) {
		const panel = document.getElementById('site-menu');
		const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
		if (!panel || !toggle) return;
		panel.classList.toggle(OPEN, open);
		toggle.setAttribute('aria-expanded', String(open));
	}

	// Delegated, so it survives the client router swapping the header. Each new page renders it closed.
	document.addEventListener('click', (event) => {
		const target = event.target as Element | null;
		const toggle = target?.closest('.menu-toggle');
		if (toggle) {
			setOpen(toggle.getAttribute('aria-expanded') !== 'true');
		} else if (target?.closest('#site-menu a')) {
			setOpen(false);
		}
	});

	document.addEventListener('keydown', (event) => {
		const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
		if (event.key !== 'Escape' || toggle?.getAttribute('aria-expanded') !== 'true') return;
		setOpen(false);
		toggle.focus();
	});
</script>

<style>
	.site-header {
		position: relative;
		z-index: 50;
		background: var(--line);
		border-bottom: var(--border-width) solid var(--ink);
	}

	.bar {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-3);
		padding-block: 0.75rem;
	}

	.brand {
		padding: 0.1rem 0.6rem 0.15rem;
		background: var(--color-lemon);
		color: var(--on-color);
		border: var(--border-width) solid var(--ink);
		box-shadow: var(--shadow-sm);
		font-family: var(--font-head);
		font-size: 1.5rem;
		font-weight: 400;
		letter-spacing: 0.01em;
		text-decoration: none;
		text-transform: uppercase;
		transform: rotate(-2deg);
		transition: transform 0.1s ease;
	}

	.brand:hover {
		transform: rotate(2deg);
	}

	.menu-toggle {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		min-height: 2.75rem;
		padding: 0.25rem 0.8rem;
		background: var(--color-surface);
		color: var(--color-fg);
		border: 3px solid var(--ink);
		box-shadow: var(--shadow-sm);
		font: inherit;
		font-size: 0.8125rem;
		font-weight: 800;
		text-transform: uppercase;
		cursor: pointer;
	}

	.menu-toggle:hover,
	.menu-toggle[aria-expanded='true'] {
		background: var(--color-lemon);
		color: var(--on-color);
	}

	.menu-toggle svg {
		fill: none;
		stroke: currentColor;
		stroke-width: 3;
		stroke-linecap: square;
	}

	.menu-toggle[aria-expanded='false'] .icon-close,
	.menu-toggle[aria-expanded='true'] .icon-open {
		display: none;
	}

	/* On a phone the panel is closed until the toggle opens it, then the nav takes its own rows. */
	.panel {
		display: none;
		order: 3;
		width: 100%;
		padding-block: var(--space-2) var(--space-1);
	}

	.panel.is-open {
		display: block;
	}

	.panel :global(.lang-switcher) {
		margin-top: var(--space-3);
	}

	.panel :global(.lang-switcher ul) {
		width: fit-content;
	}

	/* No JavaScript, no toggle: keep everything reachable. */
	@media (scripting: none) {
		.panel {
			display: block;
		}

		.menu-toggle {
			display: none;
		}
	}

	.main-nav {
		width: 100%;
	}

	.main-nav ul {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: var(--space-1);
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.main-nav a {
		display: grid;
		place-items: center;
		height: 100%;
		min-height: 2.75rem;
		padding: 0.25rem;
		border: 3px solid transparent;
		font-size: 0.75rem;
		font-weight: 800;
		line-height: 1.1;
		text-align: center;
		text-decoration: none;
		text-transform: uppercase;
	}

	.main-nav a:hover,
	.main-nav a[aria-current='page'] {
		border-color: var(--ink);
		box-shadow: var(--shadow-sm);
		background: var(--color-lemon);
		color: var(--on-color);
	}

	.main-nav li:last-child {
		grid-column: 1 / -1;
	}

	/* Five links in two even rows: three on top, two below, always filling the width. */
	@media (min-width: 23rem) {
		.main-nav ul {
			grid-template-columns: repeat(6, minmax(0, 1fr));
		}

		.main-nav li {
			grid-column: span 2;
		}

		.main-nav li:nth-last-child(-n + 2) {
			grid-column: span 3;
		}
	}

	/* From tablet up: one row, stuck to the top. Needs this much width to hold all five links. */
	@media (min-width: 60rem) {
		.site-header {
			position: sticky;
			top: 0;
		}

		.bar {
			flex-wrap: nowrap;
		}

		.menu-toggle {
			display: none;
		}

		.panel,
		.panel.is-open {
			display: contents;
		}

		.panel :global(.lang-switcher) {
			margin-top: 0;
		}

		.main-nav {
			width: auto;
		}

		.main-nav ul {
			display: flex;
			gap: var(--space-2);
		}

		.main-nav a {
			padding: 0.25rem 0.7rem;
			font-size: 0.9375rem;
		}
	}
</style>
