---
import ProjectShot from './ProjectShot.astro';

interface Props {
	steps: string[];
	cover?: boolean;
}

const { steps, cover = false } = Astro.props;
---

<ProjectShot host="self-hosted" cover={cover}>
	<ol class:list={['pipeline', { cover }]}>
		{steps.map((step) => <li>{step}</li>)}
	</ol>
</ProjectShot>

<style>
	/* A project with no public screen shows how it works: the same window, drawn as a terminal. */
	.pipeline {
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: 1.25rem;
		list-style: none;
		margin: 0;
		padding: 1rem;
		background: var(--line);
		color: var(--paper);
		font-family: var(--font-label);
		font-size: 0.8125rem;
		font-weight: 700;
	}

	.pipeline.cover {
		aspect-ratio: 4 / 3;
	}

	li {
		position: relative;
		display: flex;
		flex: 1;
		align-items: center;
		justify-content: center;
		padding: 0.3rem 0.5rem;
		border: 2px solid var(--paper);
		text-align: center;
	}

	/* The arrow sits in the gap between boxes. It is decoration: the ordered list already gives the sequence. */
	li:not(:last-child)::after {
		content: '↓' / '';
		position: absolute;
		top: calc(100% + 2px);
		left: 50%;
		translate: -50% 0;
		line-height: 1.25rem;
	}

	/* With the whole page width available, the flow reads left to right. */
	@media (min-width: 60rem) {
		.pipeline:not(.cover) {
			flex-direction: row;
			align-items: stretch;
			padding: 1.5rem;
			font-size: 0.9375rem;
		}

		.pipeline:not(.cover) li {
			min-height: 5rem;
		}

		.pipeline:not(.cover) li:not(:last-child)::after {
			content: '→' / '';
			top: 50%;
			left: calc(100% + 2px);
			width: 1.25rem;
			translate: 0 -50%;
			text-align: center;
		}
	}

	li:last-child {
		background: var(--color-lemon);
		color: var(--line);
		border-color: var(--color-lemon);
	}
</style>
